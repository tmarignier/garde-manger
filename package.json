{
  "name": "garde-manger",
  "version": "1.6.0",
  "private": true,
  "description": "Application web familiale de gestion des stocks d'épicerie",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.client.json",
    "dev": "node scripts/dev.ts",
    "start": "npm run build && node server/index.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "addon:local": "npm run build && node scripts/local-addon.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
